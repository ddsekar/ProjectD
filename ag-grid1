const columnDefs = [
    { field: 'id', headerName: 'ID', width: 80 },
    { field: 'event', headerName: 'Event', width: 200 },
    {
        field: 'createdAt',
        headerName: 'Created At',
        filter: 'agDateColumnFilter', // Use the built-in date filter
        sortable: true, // Timestamps sort naturally
        // Optional: valueFormatter to display the timestamp in a readable date format
        valueFormatter: params => {
            if (params.value) {
                // params.value is the timestamp (number)
                const date = new Date(params.value);
                // Format to a local date string (e.g., "Mon, Jun 16, 2024")
                return date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    weekday: 'short',
                    hour: '2-digit',
                    minute: '2-digit',
                });
            }
            return '';
        },
        filterParams: {
            // The crucial part: a comparator to handle timestamp vs. Date object comparison
            comparator: (filterLocalDateAtMidnight, cellValue) => {
                // filterLocalDateAtMidnight: The date selected in the filter (JavaScript Date object, time set to 00:00:00 local time).
                // cellValue: The actual value from your rowData (the timestamp number).

                if (cellValue == null) {
                    return -1; // Handle null/undefined values
                }

                // Convert the timestamp (cellValue) into a JavaScript Date object.
                // Ensure it's treated at midnight for comparison with filterLocalDateAtMidnight.
                // We create a Date object from the timestamp, then set its time to 00:00:00
                // to compare just the date part.
                const cellDate = new Date(cellValue);
                const cellDateAtMidnight = new Date(
                    cellDate.getFullYear(),
                    cellDate.getMonth(),
                    cellDate.getDate()
                );

                // Now, compare the two Date objects
                if (cellDateAtMidnight < filterLocalDateAtMidnight) {
                    return -1; // Cell date is before the filter date
                } else if (cellDateAtMidnight > filterLocalDateAtMidnight) {
                    return 1;  // Cell date is after the filter date
                }
                return 0;      // Dates are the same
            },
            // Other optional filterParams for agDateColumnFilter:
            // browserDatePicker: true, // Use the native browser date picker
            // filterOptions: ['equals', 'lessThan', 'greaterThan', 'inRange'],
            // suppressAndOrCondition: true, // Only show one filter condition
        },
    },
];

