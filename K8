### ✅ Java Code: Create and Monitor a Pod

```java
import io.kubernetes.client.openapi.ApiClient;
import io.kubernetes.client.openapi.Configuration;
import io.kubernetes.client.openapi.apis.CoreV1Api;
import io.kubernetes.client.openapi.models.*;
import io.kubernetes.client.util.Config;
import io.kubernetes.client.util.Watch;
import com.google.gson.reflect.TypeToken;
import okhttp3.Call;

import java.util.Collections;

public class PodManager {

    public static void main(String[] args) throws Exception {
        String podName = "custom-nginx-pod";
        String image = "nginx:latest";
        String namespace = "default";

        ApiClient client = Config.defaultClient();
        Configuration.setDefaultApiClient(client);
        CoreV1Api api = new CoreV1Api();

        // Create Pod
        V1Pod pod = new V1Pod()
                .apiVersion("v1")
                .kind("Pod")
                .metadata(new V1ObjectMeta().name(podName).labels(Collections.singletonMap("app", "nginx")))
                .spec(new V1PodSpec().containers(Collections.singletonList(
                        new V1Container()
                                .name("nginx")
                                .image(image)
                                .ports(Collections.singletonList(new V1ContainerPort().containerPort(80)))
                )));

        api.createNamespacedPod(namespace, pod, null, null, null);
        System.out.println("✅ Pod created: " + podName);

        // Monitor Pod Status
        Call call = api.listNamespacedPodCall(namespace, null, null, null,
                "metadata.name=" + podName, null, null, null, null, true, null);

        try (Watch<V1Pod> watch = Watch.createWatch(
                client,
                call,
                new TypeToken<Watch.Response<V1Pod>>() {}.getType())) {

            for (Watch.Response<V1Pod> event : watch) {
                V1Pod watchedPod = event.object;
                String phase = watchedPod.getStatus().getPhase();
                System.out.printf("📡 Event: %s | Status: %s%n", event.type, phase);

                if ("Running".equalsIgnoreCase(phase) || "Failed".equalsIgnoreCase(phase) || "Succeeded".equalsIgnoreCase(phase)) {
                    System.out.println("🎯 Final Pod Status: " + phase);
                    break;
                }
            }
        }
    }
}
```

