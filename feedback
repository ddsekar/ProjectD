  initialRating={7}
  title="How do you feel about your experience?"
  sentimentLabels={{
    satisfied: "Loved it",
    neutral: "It was OK",
    notSatisfied: "Not great"
  }}
  className="custom-feedback"
  style={{ margin: 20 }}
