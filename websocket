import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

@RestController
public class LogController {

    private final LogWebSocketHandler logWebSocketHandler;

    @Autowired
    public LogController(LogWebSocketHandler logWebSocketHandler) {
        this.logWebSocketHandler = logWebSocketHandler;
    }

    // Example endpoint: POST /test-log
    @PostMapping("/test-log")
    public void sendTestLog(@RequestBody(required = false) String message) {
        String logLine = (message == null || message.isEmpty()) 
                ? "Test log at " + java.time.LocalDateTime.now() 
                : message;
        logWebSocketHandler.broadcastLogLine(logLine);
    }
}


@Configuration
@EnableWebSocket
public class WebSocketConfig implements WebSocketConfigurer {
    @Bean
    public LogWebSocketHandler logWebSocketHandler() {
        return new LogWebSocketHandler();
    }

    @Override
    public void registerWebSocketHandlers(WebSocketHandlerRegistry registry) {
        registry.addHandler(logWebSocketHandler(), "/ws/logs")
                .setAllowedOrigins("*");
    }
}


