import React, { useEffect, useRef, useState } from 'react';

export default function LogViewer({
  websocketUrl,
  width = '80vw',
  height = '80vh',
  enableStop = false,
  className = '',
  maxLines = null,
  autoScroll = true,
  placeholder = '',
  hideAfterCompletion = false,
  hideDelay = 0, // new prop: delay in ms before hiding
}) {
  const [logs, setLogs] = useState('');
  const [lines, setLines] = useState([]);
  const [stopped, setStopped] = useState(false);
  const [finished, setFinished] = useState(false);
  const [hide, setHide] = useState(false);
  const ws = useRef(null);
  const textareaRef = useRef(null);
  const hideTimeoutRef = useRef(null);

  useEffect(() => {
    if (!stopped && websocketUrl) {
      ws.current = new WebSocket(websocketUrl);

      ws.current.onmessage = (event) => {
        setLines((prevLines) => {
          let newLines = [...prevLines, event.data];
          if (maxLines && newLines.length > maxLines) {
            newLines = newLines.slice(newLines.length - maxLines);
          }
          setLogs(newLines.join('\n'));
          return newLines;
        });
      };

      ws.current.onclose = () => {
        setFinished(true);
        console.log('WebSocket closed');
      };

      ws.current.onerror = () => console.log('WebSocket error');

      return () => {
        ws.current && ws.current.close();
        if (hideTimeoutRef.current) {
          clearTimeout(hideTimeoutRef.current);
        }
      };
    }
  }, [websocketUrl, stopped, maxLines]);

  useEffect(() => {
    if (autoScroll && textareaRef.current) {
      textareaRef.current.scrollTop = textareaRef.current.scrollHeight;
    }
  }, [logs, autoScroll]);

  // Start delay timer to hide after completion
  useEffect(() => {
    if (hideAfterCompletion && finished) {
      hideTimeoutRef.current = setTimeout(() => {
        setHide(true);
      }, hideDelay);
    }
    return () => {
      if (hideTimeoutRef.current) {
        clearTimeout(hideTimeoutRef.current);
      }
    };
  }, [finished, hideAfterCompletion, hideDelay]);

  const clearLogs = () => {
    setLogs('');
    setLines([]);
  };

  const stopLogs = () => {
    ws.current && ws.current.close();
    setStopped(true);
  };

  if (hideAfterCompletion && hide) return null;

  return (
    <div>
      <textarea
        ref={textareaRef}
        value={logs}
        readOnly
        className={className}
        placeholder={placeholder}
        style={{ width, height, display: 'block' }}
      />
      <button onClick={clearLogs}>Clear</button>
      {enableStop && (
        <button onClick={stopLogs} disabled={stopped}>
          Stop
        </button>
      )}
    </div>
  );
}
